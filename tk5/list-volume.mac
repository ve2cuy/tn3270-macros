# List the data sets of a volume (TSO VTOC at READY: organization, format, size, name).
# Works from ISPF, READY or a "***" prompt. Stops on the first page: Enter shows the next.
ask vol "Volume" "TSO002"
# Up to READY: "***" prompts, then PF3 out of ISPF panels and X on the primary menu.
repeat 15
  if blank enter
  wait "===>" "READY" "***"
  if "***" enter
  wait "===>" "READY"
  if "READY" break
  if "ISPF primary option menu" type "X"
  if "ISPF primary option menu" enter
  ifnot "ISPF primary option menu" pf3
end
clear
type "VTOC {vol}"
enter
wait 60 "READY" "***"
