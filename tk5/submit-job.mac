# Submit a job and wait for its end (TSO SUBMIT and STATUS at READY), then back to the
# ISPF menu. Works from ISPF, READY or a "***" prompt. Done: output held (ON OUTPUT
# QUEUE) or already printed and purged (NOT FOUND).
ask dsn "JCL data set" "'SYS2.JCLLIB(TESTCOB)'"
ask job "Job name" "TESTCOB"
# Up to READY: "***" prompts, then PF3 out of ISPF panels and X on the primary menu.
repeat 15
  if blank enter
  wait "===>" "READY" "***"
  if "***" enter
  wait "===>" "READY"
  if "READY" break
  if "ISPF primary option menu" type "X"
  if "ISPF primary option menu" enter
  ifnot "ISPF primary option menu" pf3
end
clear
type "SUBMIT {dsn}"
enter
wait 60 "READY"
ifnot "SUBMITTED" stop "Submit failed"
repeat 100
  pause 3
  clear
  type "STATUS {job}"
  enter
  wait 30 "READY"
  if "ON OUTPUT QUEUE" break
  if "NOT FOUND" break
end
# Back to the ISPF primary menu.
clear
type "ISPF"
enter
wait 30 "Option  ===>"
