# TSO logoff: leave ISPF (PF3, then X on the primary menu), then LOGOFF.
repeat 15
  if blank enter
  wait "===>" "READY" "***"
  if "***" enter
  wait "===>" "READY"
  if "READY" break
  if "ISPF primary option menu" type "X"
  if "ISPF primary option menu" enter
  ifnot "ISPF primary option menu" pf3
end
type "LOGOFF"
enter
wait 60 "Logon ===>"
